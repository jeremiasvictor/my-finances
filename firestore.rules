// firestore.rules
// Deploy with: firebase deploy --only firestore:rules
// Or paste directly into Firebase Console → Firestore → Rules

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only read/write their own sub-collections
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// NOTE: You'll also need these composite indexes in Firebase Console:
// users/{uid}/budgetPlans  → month ASC, year ASC, createdAt ASC
// users/{uid}/invoices     → month ASC, year ASC, createdAt ASC
// users/{uid}/invoiceMembers → invoiceId ASC, createdAt ASC
